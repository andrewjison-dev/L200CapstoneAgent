# ============================================================================
# Isolated Placeholder Configuration (NO hardcoded secrets or live keys)
# Copy to `.env` and substitute placeholders when connecting to Google Cloud.
# ============================================================================

# Execution Mode: "isolated" (default offline-safe mode) or "cloud" (Vertex AI + GCP)
CONCIERGE_ENV_MODE=isolated

# Google ADK / Vertex AI Configuration Placeholders
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT={{PLACEHOLDER_GCP_PROJECT_ID}}
GOOGLE_CLOUD_LOCATION=us-central1

# Secret Manager Secret IDs (injected at runtime via SecretManagerProvider; never hardcode values)
GEMINI_API_KEY_SECRET_ID={{PLACEHOLDER_GEMINI_API_KEY_SECRET_ID}}
GROCERY_PROVIDER_API_SECRET_ID={{PLACEHOLDER_GROCERY_API_SECRET_ID}}
FAMILY_CALENDAR_OAUTH_SECRET_ID={{PLACEHOLDER_CALENDAR_OAUTH_SECRET_ID}}

# External Integration Placeholders (disconnected by default in isolated mode)
VERTEX_SEARCH_DATASTORE_ID={{PLACEHOLDER_VERTEX_SEARCH_DATASTORE_ID}}
VERTEX_MEMORY_BANK_AGENT_ENGINE_ID={{PLACEHOLDER_AGENT_ENGINE_ID}}
MODEL_ARMOR_TEMPLATE_ID={{PLACEHOLDER_MODEL_ARMOR_TEMPLATE_ID}}
FAMILY_CALENDAR_ID={{PLACEHOLDER_FAMILY_CALENDAR_ID}}
GROCERY_PARTNER_STORE_ID={{PLACEHOLDER_GROCERY_STORE_ID}}

# Persistent Session & Vector Database URL
SESSION_DATABASE_URL=sqlite:///./.concierge_state/concierge_sessions.db

# Strategic Model Routing Tiers
FAST_MODEL_NAME=gemini-2.5-flash
PLANNING_MODEL_NAME=gemini-2.5-pro

# Observability & Guardrail Thresholds
OTEL_SERVICE_NAME=andrew-family-concierge-agent
GROCERY_BUDGET_DEFAULT_USD=225.00
GROCERY_HITL_APPROVAL_THRESHOLD_USD=1.00
MAX_WEEKNIGHT_ACTIVE_COOK_MINUTES=30
